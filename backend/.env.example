# Cổng chạy Backend Server
PORT=3000

# Chuỗi kết nối MongoDB (Mặc định local: vlxd-hub)
MONGODB_URI=mongodb://127.0.0.1:27017/vlxd-hub

# Mã bí mật mã hóa JSON Web Token
JWT_SECRET=vlxd_hub_secret_key_2026_super_secure

# Google Gemini API Key (Lấy miễn phí tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
